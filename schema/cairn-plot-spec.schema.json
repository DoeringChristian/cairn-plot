{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/PlotDescriptor",
  "definitions": {
    "PlotDescriptor": {
      "type": "object",
      "properties": {
        "root": {
          "$ref": "#/definitions/PlotNode"
        },
        "mode": {
          "type": "string",
          "enum": [
            "local",
            "endpoint"
          ],
          "description": "Standalone bootstrap transport metadata; PlotHost always receives DataSource explicitly."
        },
        "endpoint": {
          "type": "string"
        }
      },
      "required": [
        "root"
      ],
      "additionalProperties": false,
      "description": "The one durable recursive plot specification shared by Python and JS."
    },
    "PlotNode": {
      "anyOf": [
        {
          "$ref": "#/definitions/PlotLeafNode"
        },
        {
          "$ref": "#/definitions/GridNode"
        },
        {
          "$ref": "#/definitions/CompareNode"
        }
      ]
    },
    "PlotLeafNode": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "plot"
        },
        "renderer": {
          "type": "string"
        },
        "props": {
          "$ref": "#/definitions/Record%3Cstring%2CJsonValue%3E"
        },
        "data": {
          "$ref": "#/definitions/DataSpec"
        }
      },
      "required": [
        "kind",
        "renderer",
        "data"
      ],
      "additionalProperties": false
    },
    "Record<string,JsonValue>": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/JsonValue"
      }
    },
    "JsonValue": {
      "anyOf": [
        {
          "$ref": "#/definitions/JsonPrimitive"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/JsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/JsonValue"
          }
        }
      ]
    },
    "JsonPrimitive": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "DataSpec": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "inline"
            },
            "props": {
              "$ref": "#/definitions/Record%3Cstring%2CJsonValue%3E"
            }
          },
          "required": [
            "kind",
            "props"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "image"
            },
            "hash": {
              "type": [
                "string",
                "null"
              ]
            },
            "referenceHash": {
              "type": [
                "string",
                "null"
              ]
            },
            "metadata": {
              "type": [
                "string",
                "null"
              ]
            },
            "format": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "part": {
              "type": [
                "number",
                "string"
              ]
            },
            "layer": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            }
          },
          "required": [
            "kind",
            "hash"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "npz"
            },
            "hash": {
              "type": [
                "string",
                "null"
              ]
            },
            "objectType": {
              "type": "string",
              "enum": [
                "pointcloud",
                "mesh",
                "volume",
                "boxes3d"
              ]
            },
            "meta": {
              "$ref": "#/definitions/Record%3Cstring%2CJsonValue%3E"
            }
          },
          "required": [
            "kind",
            "hash",
            "objectType",
            "meta"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "imghdr"
            },
            "hash": {
              "type": [
                "string",
                "null"
              ]
            },
            "meta": {
              "$ref": "#/definitions/Record%3Cstring%2CJsonValue%3E"
            }
          },
          "required": [
            "kind",
            "hash",
            "meta"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "url"
            },
            "src": {
              "type": "string"
            },
            "referenceSrc": {
              "type": [
                "string",
                "null"
              ]
            },
            "metadata": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "src"
          ],
          "additionalProperties": false
        }
      ],
      "description": "JSON-safe data consumed by a renderer."
    },
    "GridNode": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "grid"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PlotNode"
          }
        },
        "cols": {
          "type": "number"
        },
        "colWidths": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "string"
            ]
          }
        },
        "rowHeights": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "string"
            ]
          }
        },
        "gap": {
          "type": [
            "number",
            "string"
          ]
        },
        "shared": {
          "$ref": "#/definitions/SharedProps"
        },
        "mode": {
          "type": "string",
          "enum": [
            "normal",
            "stacked"
          ],
          "description": "`normal` creates one internal viewport per child. `stacked` creates one internal viewport whose children are content slots. Switching slots never replaces that viewport's settings."
        },
        "switchable": {
          "type": "boolean",
          "description": "Every multi-child grid is switchable by default; false hides the toggle."
        }
      },
      "required": [
        "kind",
        "children"
      ],
      "additionalProperties": false
    },
    "SharedProps": {
      "type": "object",
      "properties": {
        "colormap": {
          "type": "string"
        },
        "colorRange": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "colorbar": {
          "type": "boolean"
        },
        "reference": {
          "$ref": "#/definitions/DataSpec"
        },
        "sync": {
          "type": "object",
          "properties": {
            "viewport": {
              "type": "boolean"
            },
            "camera": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "CompareNode": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "compare"
        },
        "renderer": {
          "type": "string",
          "description": "Plot definition that owns comparison semantics. Omission means `image`."
        },
        "presentation": {
          "type": "string",
          "description": "Plot-defined presentation (`overlay`, `difference`, …)."
        },
        "mode": {
          "type": "string",
          "enum": [
            "split",
            "diff"
          ],
          "description": "Legacy image spelling. New descriptors should use `presentation`."
        },
        "a": {
          "$ref": "#/definitions/DataSpec"
        },
        "b": {
          "$ref": "#/definitions/DataSpec"
        },
        "baselineIndex": {
          "type": "number",
          "enum": [
            0,
            1
          ]
        },
        "diffSubmode": {
          "type": "string"
        },
        "align": {
          "type": "string",
          "enum": [
            "top-left",
            "center",
            "top-right",
            "bottom-left",
            "bottom-right"
          ]
        },
        "fit": {
          "type": "string",
          "enum": [
            "crop",
            "fill"
          ]
        },
        "props": {
          "$ref": "#/definitions/Record%3Cstring%2CJsonValue%3E"
        }
      },
      "required": [
        "kind",
        "a",
        "b"
      ],
      "additionalProperties": false
    }
  }
}
